# ───────────── Supabase (Project Settings → API) ─────────────
NEXT_PUBLIC_SUPABASE_URL=https://yuylqltuidafwxpyklsf.supabase.co
# Isi dengan "Publishable key" (sb_publishable_...) ATAU anon key legacy. Keduanya aman dipakai di browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_-HmVqEU1pPz6DNs0caUF1A_hsFUxuWC

# ───────────── Database (Project Settings → Database → Connect) ─────────────
# Untuk aplikasi (runtime di Vercel): Transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.yuylqltuidafwxpyklsf:@akhsanul044@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Untuk migrasi/`prisma db push`: Session pooler (port 5432) atau Direct connection
DIRECT_URL="postgresql://postgres.yuylqltuidafwxpyklsf:@akhsanul044@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# ───────────── Aplikasi ─────────────
# Rahasia untuk menandatangani cookie akses jurnal yang diproteksi password.
# Buat dengan:  openssl rand -base64 32
JOURNAL_COOKIE_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Zona waktu untuk tampilan tanggal & kalender (IANA name)
APP_TIMEZONE=Asia/Jakarta

# Setelah akun pemilik dibuat, set "false" agar orang lain tidak bisa mendaftar.
ALLOW_REGISTRATION=true
